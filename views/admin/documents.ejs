<%- include('../partials/header') %><div class="admin-wrap"><div class="admin-panel"><p class="eyebrow">CONTENT MANAGEMENT</p><h1>Documents & publications</h1><div class="admin-nav"><a href="/admin">← Dashboard</a></div><form class="admin-form" method="post" enctype="multipart/form-data" action="/admin/documents"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Add a document</h2><label>Document title<input name="title" required maxlength="180"></label><label>Description<textarea name="description" maxlength="1000"></textarea></label><label>Category<select name="category"><option value="report">Report</option><option value="policy">Policy</option><option value="strategy">Strategy</option><option value="brief">Brief</option><option value="resource">Other resource</option></select></label><label>File (PDF, Word, Excel, PowerPoint or CSV; maximum 15 MB)<input type="file" name="document_file" required accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.csv"></label><label class="check"><input type="checkbox" name="published" value="1"> Publish for public download</label><button class="admin-button red" type="submit">Upload document</button></form><h2 style="margin-top:36px">Uploaded documents</h2><table class="admin-table"><thead><tr><th>Title</th><th>Category</th><th>Visibility</th><th>File</th><th>Action</th></tr></thead><tbody><% items.forEach(d=>{ %><tr><td><%= d.title %></td><td><%= d.category %></td><td><%= d.published?'Published':'Draft' %></td><td><%= d.original_name %></td><td><form method="post" action="/admin/documents/<%= d.id %>/delete" onsubmit="return confirm('Delete this document?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="admin-button" type="submit">Delete</button></form></td></tr><% }) %></tbody></table></div></div><%- include('../partials/footer') %>
