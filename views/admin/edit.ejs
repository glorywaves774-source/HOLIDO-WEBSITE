<%- include('../partials/header') %><div class="admin-wrap"><div class="admin-panel"><p class="eyebrow">CONTENT MANAGEMENT</p><h1><%= title %></h1><div class="admin-nav"><a href="/admin/content/<%= type %>">← Back to <%= label %></a></div><form class="admin-form" method="post" enctype="multipart/form-data" action="<%= item?'/admin/content/'+type+'/'+item.id:'/admin/content/'+type %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Title<input name="title" required maxlength="180" value="<%= item?item.title:'' %>"></label><label>URL slug<input name="slug" value="<%= item?item.slug:'' %>" placeholder="generated-from-title-if-empty"></label><label>Short summary<textarea name="summary" maxlength="500"><%= item?item.summary:'' %></textarea></label><label>Full description / story<textarea name="body" maxlength="12000"><%= item?item.body:'' %></textarea></label><label>Image URL (optional)<input name="image" value="<%= item?item.image:'' %>" placeholder="https://..."></label><label>Or upload an image (JPG, PNG, WEBP, GIF; max 5 MB)<input type="file" name="image_file" accept="image/jpeg,image/png,image/webp,image/gif"></label><% if(item&&item.image){ %><img src="<%= item.image %>" alt="Current image" style="width:180px;max-height:130px;object-fit:cover"><% } %><label>Category<input name="category" value="<%= item?item.category:'' %>"></label><label>Author / beneficiary name<input name="author" value="<%= item?item.author:'' %>"></label><label>Role / designation<input name="role" value="<%= item?item.role:'' %>"></label><label>Location<input name="location" value="<%= item?item.location:'' %>"></label><label>Display order<input name="sort_order" type="number" value="<%= item?item.sort_order:0 %>"></label><label class="check"><input type="checkbox" name="published" value="1" <%= !item||item.published?'checked':'' %>> Publish on the public website</label><button class="admin-button red" type="submit">Save content</button></form><% if(item){ %><form method="post" action="/admin/content/<%= type %>/<%= item.id %>/delete" onsubmit="return confirm('Delete this record permanently?')" style="margin-top:24px"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="admin-button" type="submit">Delete record</button></form><% } %></div></div><%- include('../partials/footer') %>
