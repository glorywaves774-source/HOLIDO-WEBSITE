<%- include('../partials/header') %><% const isP = type==='person'; %><div class="admin-wrap"><div class="admin-panel"><p class="eyebrow">CONTENT MANAGEMENT</p><h1><%= title %></h1><div class="admin-nav"><a href="/admin/content/<%= type %>">← Back to <%= label %></a></div>
<form class="admin-form" method="post" enctype="multipart/form-data" action="<%= item?'/admin/content/'+type+'/'+item.id:'/admin/content/'+type %>">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<label><%= isP ? 'Full name' : 'Title' %><% if(isP){ %> <small class="hint">Include the title, for example Mr., Mrs., Dr. or Hon.</small><% } %><input name="title" required maxlength="180" value="<%= item?item.title:'' %>"<%- isP ? ' placeholder="Mr. First Last"' : '' %>></label>
<label>URL slug<input name="slug" value="<%= item?item.slug:'' %>" placeholder="generated-from-title-if-empty"></label>
<% if(isP){ %>
<label>Position on the Board <small class="hint">For example Chairman &amp; Founder, Secretary, Treasurer or Member.</small><input name="role" maxlength="200" value="<%= item?item.role:'' %>" placeholder="Member"></label>
<label>Qualifications <small class="hint">Degrees, certificates and professional titles, shown under the name. Up to 400 characters.</small><input name="qualifications" maxlength="400" value="<%= item?(item.qualifications||''):'' %>" placeholder="MSc, Development Management"></label>
<label>Personality in a few words <small class="hint">Short descriptive words or phrases, separated by commas, shown as tags (for example: Visionary, Patient listener, Calm under pressure).</small><input name="traits" maxlength="600" value="<%= item?(item.traits||''):'' %>"></label>
<% } %>
<% if(isP){ %><label>Short introduction <small class="hint">One or two sentences shown at the top of the profile. Up to 2,000 characters, shown in full.</small><textarea name="summary" maxlength="2000" rows="3"><%= item?item.summary:'' %></textarea></label>
<% } else { %><label>Short summary <small class="hint">Shown on cards and under the page title. Up to 2,000 characters, shown in full.</small><textarea name="summary" maxlength="2000" rows="4"><%= item?item.summary:'' %></textarea></label><% } %>
<% if(isP){ %><label>Personality profile <small class="hint">Write as much as you like (up to 100,000 characters). Everything is shown in full on the Our People page. Leave a blank line between paragraphs. Start a line with <code>## </code> for a sub-heading, <code>- </code> for bullets or <code>&gt; </code> for a quotation. Use <code>**bold**</code>, <code>*italic*</code> and <code>[link text](https://…)</code>.</small><textarea name="body" class="body-field" maxlength="100000" rows="16" data-count placeholder="## Background&#10;Where they come from, their career and how they came to HOLIDO.&#10;&#10;## Personality and leadership style&#10;How they work with others, what people say about them, what drives them.&#10;&#10;## Why HOLIDO&#10;What they hope the organisation will achieve.&#10;&#10;## Outside work&#10;Interests, community roles, family or faith, if they wish to share."><%= item?item.body:'' %></textarea><small class="hint char-count" data-count-for="body"></small></label>
<label>Areas of expertise <small class="hint">One per line (or separated by commas). Shown as tags under the profile.</small><textarea name="expertise" maxlength="3000" rows="4"><%= item?(item.expertise||''):'' %></textarea></label>
<label>Personal quote or motto <small class="hint">Optional. Shown as a highlighted quotation on the profile.</small><textarea name="quote" maxlength="1500" rows="3"><%= item?(item.quote||''):'' %></textarea></label>
<% } else { %><label>Full description / story <small class="hint">Up to 100,000 characters, shown in full on the page. Leave a blank line between paragraphs. Start a line with <code>- </code> for bullets, <code>1. </code> for numbered lists, <code>## </code> for a sub-heading or <code>&gt; </code> for a quotation. Use <code>**bold**</code>, <code>*italic*</code> and <code>[link text](https://…)</code>.</small><textarea name="body" class="body-field" maxlength="100000" rows="14" data-count><%= item?item.body:'' %></textarea><small class="hint char-count" data-count-for="body"></small></label><% } %>

<fieldset class="media-field" data-focus-picker>
 <legend><%= isP ? 'Profile picture' : 'Picture' %></legend>
 <label>Upload an image <small class="hint">JPG, PNG, WEBP or GIF, up to 12 MB. Large photos are resized automatically.<% if(isP){ %> A head-and-shoulders portrait (taller than wide) works best.<% } %></small><input type="file" name="image_file" accept="image/jpeg,image/png,image/webp,image/gif" data-file></label>
 <label>Or image address <small class="hint">Uploading is recommended. Addresses from other websites may be blocked by the site's security policy; only holido.org addresses are allowed.</small><input name="image" value="<%= item?item.image:'' %>" placeholder="https://… or /uploads/…" data-url></label>
 <div class="focus-wrap" data-focus-wrap hidden>
  <p class="hint"><strong>Picture placement:</strong> click the most important part of the picture (a face, for example). Cards crop pictures to fit, and this point is kept in view.</p>
  <div class="focus-stage" data-stage><img alt="" data-stage-img><span class="focus-dot" data-dot></span></div>
  <div class="focus-previews"><figure><div class="fp fp-card"><img alt="" data-prev></div><figcaption>Card</figcaption></figure><figure><div class="fp fp-wide"><img alt="" data-prev></div><figcaption>Wide</figcaption></figure><figure><div class="fp fp-round"><img alt="" data-prev></div><figcaption>Round</figcaption></figure><% if(isP){ %><figure><div class="fp fp-portrait"><img alt="" data-prev></div><figcaption>Profile</figcaption></figure><% } %></div>
  <input type="hidden" name="image_pos" value="<%= item?(item.image_pos||''):'' %>" data-pos>
  <label>Picture description for screen readers (alt text) <small class="hint"><%= isP ? 'For example: Portrait of Mr. First Last. Leave blank to use this.' : 'Describe what the picture shows. Leave blank to use the title.' %></small><input name="image_alt" maxlength="300" value="<%= item?(item.image_alt||''):'' %>"></label>
  <% if(item&&item.image){ %><label class="check"><input type="checkbox" name="remove_image" value="1"> Remove this picture</label><% } %>
 </div>
</fieldset>

<% if(!isP){ %>
<label>Category<input name="category" value="<%= item?item.category:'' %>"></label>
<label>Author / beneficiary name<input name="author" value="<%= item?item.author:'' %>"></label>
<label>Role / designation<input name="role" value="<%= item?item.role:'' %>"></label>
<label>Location<input name="location" value="<%= item?item.location:'' %>"></label>
<% } %>
<label>Display order <% if(isP){ %><small class="hint">Smaller numbers appear first. The first person, if their position is Chairman, is shown as the lead profile.</small><% } %><input name="sort_order" type="number" value="<%= item?item.sort_order:0 %>"></label>
<label class="check"><input type="checkbox" name="published" value="1" <%= !item||item.published?'checked':'' %>> Publish on the public website</label>
<button class="admin-button red" type="submit">Save content</button></form>
<% if(item){ %><form method="post" action="/admin/content/<%= type %>/<%= item.id %>/delete" onsubmit="return confirm('Delete this record permanently?')" style="margin-top:24px"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="admin-button" type="submit">Delete record</button></form><% } %></div></div><%- include('../partials/footer') %>
