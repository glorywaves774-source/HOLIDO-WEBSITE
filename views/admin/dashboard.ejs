<%- include('../partials/header') %><div class="admin-wrap"><div class="admin-panel"><p class="eyebrow">HOLIDO CMS</p><h1>Website dashboard</h1><p>Signed in as <strong><%= isAdmin ? 'administrator' : '' %></strong>. Manage website content and review incoming enquiries.</p><div class="admin-nav"><a href="/admin/content/program">Programmes</a><a href="/admin/content/project">Projects</a><a href="/admin/content/story">Impact stories</a><a href="/admin/content/person">People</a><a href="/admin/content/news">News</a><a href="/admin/content/partner">Partners</a><a href="/admin/content/gallery">Gallery</a><a href="/admin/content/resource">Resources</a><a href="/admin/documents">Documents</a><a href="/admin/subscribers.csv">Subscribers CSV</a><a href="/admin/backups">Backups</a><a href="/admin/messages">Enquiries (<%= counts.messages %>)</a><form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="admin-button" type="submit">Sign out</button></form></div><div class="milestone-grid"><div><strong><%= counts.programs %></strong><span>Programmes</span></div><div><strong><%= counts.projects %></strong><span>Projects</span></div><div><strong><%= counts.stories %></strong><span>Impact stories</span></div><div><strong><%= counts.people %></strong><span>People records</span></div><div><strong><%= counts.messages %></strong><span>New enquiries</span></div><div><strong><%= counts.partners %></strong><span>Partners</span></div><div><strong><%= counts.gallery %></strong><span>Gallery items</span></div><div><strong><%= counts.documents %></strong><span>Documents</span></div><div><strong><%= counts.subscribers %></strong><span>Subscribers</span></div></div><h2 style="font:800 20px Manrope;margin-top:35px">Recent enquiries</h2><% if(messages.length){ %><table class="admin-table"><thead><tr><th>Received</th><th>Name</th><th>Email</th><th>Subject</th><th>Status</th></tr></thead><tbody><% messages.forEach(m=>{ %><tr><td><%= m.created_at %></td><td><%= m.first_name %> <%= m.last_name %></td><td><%= m.email %></td><td><%= m.subject %></td><td><%= m.status %></td></tr><% }) %></tbody></table><% }else{ %><p class="small-muted">No enquiries yet.</p><% } %><p class="small-muted">For security, create a unique administrator password and keep your hosting environment variables private.</p></div></div><%- include('../partials/footer') %>
