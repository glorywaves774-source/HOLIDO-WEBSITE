<%- include('../partials/header') %><div class="admin-wrap"><div class="admin-panel"><p class="eyebrow">CONTACT FORM</p><h1>Enquiries</h1><div class="admin-nav"><a href="/admin">← Dashboard</a></div><% if(items.length){ %><table class="admin-table"><thead><tr><th>Date</th><th>Sender</th><th>Subject / message</th><th>Status</th><th>Action</th></tr></thead><tbody><% items.forEach(m=>{ %><tr><td><%= m.created_at %></td><td><strong><%= m.first_name %> <%= m.last_name %></strong><br><a href="mailto:<%= m.email %>"><%= m.email %></a></td><td><strong><%= m.subject %></strong><br><%= m.message %></td><td><%= m.status %></td><td><form method="post" action="/admin/messages/<%= m.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="<%= m.status==='new'?'read':'new' %>"><button class="admin-button" type="submit">Mark <%= m.status==='new'?'read':'new' %></button></form></td></tr><% }) %></tbody></table><% }else{ %><p>No enquiries received yet.</p><% } %></div></div><%- include('../partials/footer') %>
