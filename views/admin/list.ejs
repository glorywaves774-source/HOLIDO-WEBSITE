<%- include('../partials/header') %><div class="admin-wrap"><div class="admin-panel"><p class="eyebrow">CONTENT MANAGEMENT</p><h1><%= label %></h1><div class="admin-nav"><a href="/admin">← Dashboard</a><a class="admin-button red" href="/admin/content/<%= type %>/new">+ Add new</a></div><table class="admin-table"><thead><tr><th>Picture</th><th>Title</th><th>URL slug</th><th>Visibility</th><th>Order</th><th>Actions</th></tr></thead><tbody><% items.forEach(item=>{ %><tr><td><% if(item.image){ %><img class="admin-thumb" src="<%= item.image %>" alt="" style="object-position:<%= imgPos(item) %>"><% } %></td><td><strong><%= item.title %></strong><% if(type==='person' && item.role){ %><br><small><%= item.role %></small><% } %></td><td>/<%= type==='program'?'programmes':type==='story'?'impact':type %>/<%= item.slug %></td><td><%= item.published?'Published':'Draft' %></td><td><%= item.sort_order %></td><td><a class="text-link" href="/admin/content/<%= type %>/<%= item.id %>/edit">Edit</a></td></tr><% }) %></tbody></table><% if(!items.length){ %><p>No records yet. Add the first one.</p><% } %></div></div><%- include('../partials/footer') %>
