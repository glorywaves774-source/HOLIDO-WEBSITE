<%- include('../partials/header') %><div class="admin-wrap"><div class="admin-panel"><p class="eyebrow">CONTENT MANAGEMENT</p><h1><%= label %></h1><div class="admin-nav"><a href="/admin">← Dashboard</a><a class="admin-button red" href="/admin/content/<%= type %>/new">+ Add new</a></div><table class="admin-table"><thead><tr><th>Title</th><th>URL slug</th><th>Visibility</th><th>Order</th><th>Actions</th></tr></thead><tbody><% items.forEach(item=>{ %><tr><td><strong><%= item.title %></strong></td><td>/<%= type==='program'?'programmes':type==='story'?'impact':type %>/<%= item.slug %></td><td><%= item.published?'Published':'Draft' %></td><td><%= item.sort_order %></td><td><a class="text-link" href="/admin/content/<%= type %>/<%= item.id %>/edit">Edit</a></td></tr><% }) %></tbody></table><% if(!items.length){ %><p>No records yet. Add the first one.</p><% } %></div></div><%- include('../partials/footer') %>
