<%- include('partials/header') %>
<% if (pageKey === 'home') { %>
<%
/* Hero slideshow. To change a photo: drop JPEGs named <file>-<width>.jpg into public/images/hero/ and edit this list.
   pos / posM = focal point on desktop / phones. framed = tall photo shown whole on a blurred backdrop (desktop only). */
const heroSlides=[
 {file:'community-meeting',widths:[900,1280],pos:'50% 42%',posM:'52% 42%',caption:'Community meeting in the shade of a village tree',alt:'A facilitator in a blue top speaks to a large circle of women and men seated and standing under a big tree in a village'},
 {file:'clinic-session',widths:[900,1280],posM:'25% 50%',framed:true,caption:'Health talk with mothers and babies',alt:'Mothers holding babies on benches in a clinic waiting area listen to a health talk'},
 {file:'village-group',widths:[900,1600,2400],pos:'50% 8%',posM:'52% 8%',caption:'Community members at home in the village',alt:'Seven community members stand together in front of a thatched house painted in blue and yellow'},
 {file:'school-outreach',widths:[900,1600,2400],posM:'36% 50%',framed:true,caption:'Picture-card session with school pupils',alt:'A facilitator holds up picture cards to a crowd of pupils sitting beneath trees, with a maize field behind them'},
 {file:'women-skills-group',widths:[1016],pos:'50% 14%',posM:'22% 14%',caption:'Learning together under the shelter',alt:'Women seated around sewing machines under a thatched shelter hold up picture cards, with two men and a parked motorbike beside them'},
 {file:'youth-video-session',widths:[1016],posM:'35% 50%',framed:true,caption:'Young people watching a learning video',alt:'Girls and boys gather around a laptop placed on a tree stump while a man crouches beside it'},
 {file:'mothers-health-talk',widths:[540],posM:'50% 35%',framed:true,caption:'Sharing health messages with mothers',alt:'A facilitator in a red polo shirt speaks to mothers with babies and young children seated on a covered porch'}
];
const heroSrcset=s=>s.widths.map(w=>'/assets/images/hero/'+s.file+'-'+w+'.jpg '+w+'w').join(', ');
const heroSrc=s=>'/assets/images/hero/'+s.file+'-'+s.widths.filter(w=>w<=1600).slice(-1)[0]+'.jpg';
const heroSizes='(max-width:700px) 100vw, 1360px';
%>
<section class="hero" aria-roledescription="carousel" aria-label="Photographs of HOLIDO's work" data-hero>
<div class="hero-slides" data-hero-slides aria-live="off">
<% heroSlides.forEach((s,i)=>{ %><div class="hero-slide<%= i===0?' is-active':'' %><%= s.framed?' hero-slide--framed':'' %>" role="group" aria-roledescription="slide" aria-label="Photo <%= i+1 %> of <%= heroSlides.length %>" data-caption="<%= s.caption %>"<%- i===0?'':' aria-hidden="true"' %> style="--pos:<%= s.pos||'50% 50%' %>;--pos-m:<%= s.posM||s.pos||'50% 50%' %>">
<% if(s.framed){ %><img class="hero-slide-bg" alt="" aria-hidden="true" <%- i===0 ? 'src="'+heroSrc(s)+'"' : 'data-src="'+heroSrc(s)+'"' %> decoding="async"><% } %>
<img class="hero-slide-img" alt="<%= s.alt %>" <%- i===0 ? 'src="'+heroSrc(s)+'" srcset="'+heroSrcset(s)+'" fetchpriority="high"' : 'data-src="'+heroSrc(s)+'" data-srcset="'+heroSrcset(s)+'"' %> sizes="<%= heroSizes %>" decoding="async"></div>
<% }) %></div>
<div class="hero-shade"></div>
<div class="container hero-content"><p class="eyebrow light">COMMUNITY-LED DEVELOPMENT · NORTHERN GHANA</p><h1>Building dignity.<br><em>Strengthening</em><br><em>communities.</em></h1><p class="hero-lead">Empowering women, children, youth and families across Northern Ghana.</p><div class="hero-actions"><a class="btn btn-red" href="/programmes">Explore our work <span>→</span></a><a class="btn btn-outline" href="/about">Who we are <span>→</span></a></div></div>
<div class="hero-ui"><p class="hero-caption" data-hero-caption><%= heroSlides[0].caption %></p>
<div class="hero-controls" role="group" aria-label="Slideshow controls"><button type="button" class="hero-btn" data-hero-prev aria-label="Previous photo"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
<div class="hero-dots"><% heroSlides.forEach((s,i)=>{ %><button type="button" class="hero-dot<%= i===0?' is-active':'' %>" data-hero-dot="<%= i %>" aria-label="Show photo <%= i+1 %>: <%= s.caption %>"<%- i===0?' aria-current="true"':'' %>></button><% }) %></div>
<button type="button" class="hero-btn" data-hero-next aria-label="Next photo"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
<button type="button" class="hero-btn hero-toggle" data-hero-toggle aria-label="Pause slideshow" aria-pressed="false"><svg class="i-pause" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M8 5v14M16 5v14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg><svg class="i-play" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M8 5l11 7-11 7z" fill="currentColor"/></svg></button></div></div>
</section>
<section class="focus-strip"><div class="container focus-grid"><a href="/programmes/agriculture-food-security"><span class="focus-icon">✳</span><span>Agriculture &<br>Food Security</span></a><a href="/programmes/education"><span class="focus-icon">▤</span><span>Education</span></a><a href="/programmes/health"><span class="focus-icon">＋</span><span>Health</span></a></div></section>
<% const fieldPhotos=[['school-outreach','Outreach session with school pupils','A HOLIDO facilitator shows picture cards to a seated class of pupils under a tree'],['women-leaflet','Sharing health information with women','A HOLIDO facilitator going through a leaflet with a group of women in a village'],['head-office','The HOLIDO team at the Tamale head office','Staff gathered outside the HOLIDO head office in Tamale'],['family-visit','Household visit with an information leaflet','A facilitator showing a leaflet to a grandmother and children in a compound'],['team-meeting','Team planning meeting','HOLIDO staff seated around desks during a team meeting']]; %>
<section class="field-marquee" aria-label="Photographs from HOLIDO's work"><div class="container field-marquee-head"><h2>In the field</h2><p>Community outreach, household visits and the team behind them.</p></div><div class="marquee" tabindex="0" aria-label="Scrolling photographs. Hover or focus to pause."><div class="marquee-track"><% [0,1].forEach(copy=>{ %><ul class="marquee-set"<%- copy ? ' aria-hidden="true"' : '' %>><% fieldPhotos.forEach(ph=>{ %><li><figure><img src="/assets/images/marquee/<%= ph[0] %>.jpg" alt="<%= copy ? '' : ph[2] %>" loading="lazy" decoding="async"><figcaption><%= ph[1] %></figcaption></figure></li><% }) %></ul><% }) %></div></div></section>
<section class="section intro-section"><div class="container intro-grid"><div class="intro-image"><img src="https://www.holido.org/images/WhatsApp%20Image%202026-06-15%20at%2010.01.07%20AM%20%281%29.jpeg" alt="Woman supported through a HOLIDO livelihood initiative" loading="lazy"><span class="image-note">Community-led. People-centred.</span></div><div class="intro-copy"><p class="eyebrow">WHO WE ARE</p><h2>Development that starts with people.</h2><p>Holistic Development Organisation (HOLIDO) is a non-governmental, non-profit organisation working with communities to help people overcome poverty and live with dignity.</p><p>Our work focuses on empowering women, children, youth and other marginalised people across Northern Ghana.</p><a class="text-link" href="/about">Discover HOLIDO <span>→</span></a></div><aside class="vision-card"><span class="vision-mark">◎</span><p class="eyebrow">OUR VISION</p><h3>A society without poverty where people live in dignity and harmony.</h3><a href="/about" class="text-link">Our mission and values →</a></aside></div></section>
<section class="section programmes-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">WHAT WE DO</p><h2>Our thematic areas</h2></div><p>We work with communities to build opportunity, resilience and lasting change.</p></div><div class="card-grid three"> <% programs.forEach((item,i)=>{ %><article class="program-card"><% if(item.image){ %><img src="<%= item.image %>" <%- imgAttrs(item,' programme') %> loading="lazy" decoding="async"><% } else { %><div class="program-placeholder"><span><%= i===2?'＋':i===1?'▤':'✳' %></span></div><% } %><div class="card-body"><p class="eyebrow">THEMATIC AREA 0<%= i+1 %></p><h3><%= item.title %></h3><%- cardText(item) %><a class="text-link" href="/programmes/<%= item.slug %>">Learn more →</a></div></article><% }) %></div><div class="center-action"><a class="btn btn-dark" href="/programmes">Explore all our work <span>→</span></a></div></div></section>
<section class="impact-band"><div class="container impact-band-inner"><div><p class="eyebrow light">OUR PURPOSE</p><h2>Opportunity, dignity<br>and stronger communities.</h2></div><p>From food security and education to health and livelihoods, our programmes respond to the priorities communities identify for themselves.</p><a class="btn btn-white" href="/impact">Explore our impact →</a></div></section>
<section class="section stories-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">REAL LIVES, REAL CHANGE</p><h2>Stories from our communities</h2></div><a class="text-link" href="/impact">All impact stories →</a></div><div class="card-grid three"><% stories.forEach(item=>{ %><article class="story-card"><% if(item.image){ %><img src="<%= item.image %>" <%- imgAttrs(item) %> loading="lazy" decoding="async"><% } %><div class="card-body"><p class="eyebrow"><%= item.location || item.category %></p><h3><%= item.title %></h3><%- cardText(item) %><a class="text-link" href="/impact/<%= item.slug %>">Read the story →</a></div></article><% }) %></div></div></section>
<section class="section partners-section"><div class="container partners-inner"><div><p class="eyebrow">WORKING TOGETHER</p><h2>Partnership makes progress possible.</h2><p>HOLIDO works with public institutions and development partners to support community-led change.</p></div><div class="partner-list"><% if(partners && partners.length){ partners.forEach(partner=>{ %><span><%= partner.title %></span><% }) } else { %><span>Partner information will be added as HOLIDO confirms and approves each profile.</span><% } %><a class="text-link" href="/partners">View partnership information →</a></div></div></section>
<section class="join-cta"><div class="container"><div><p class="eyebrow light">BE PART OF THE CHANGE</p><h2>Let’s build stronger communities together.</h2></div><a class="btn btn-white" href="/get-involved">Get involved <span>→</span></a></div></section>
<% } else if (pageKey === 'about') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">ABOUT HOLIDO</p><h1>People at the heart<br>of development.</h1><p>Working with communities to overcome poverty and live with dignity.</p></div></section><section class="section"><div class="container content-narrow"><p class="eyebrow">WHO WE ARE</p><h2>Holistic Development Organisation (HOLIDO)</h2><p>HOLIDO is a Non-Governmental, Non-Profit Organisation registered with the Registrar General Department (Reg. No. CG086152019) and the Department of Social Welfare (Reg. No. DSW/8097).</p><p>Formed by experienced development practitioners with expertise in Agriculture, Education and Health, we provide quality social services with the vision of helping society overcome poverty and live dignified lives.</p><p>Since inception, HOLIDO has been running development programmes especially for the empowerment of women, children, youth and other marginalised people across the Upper East, Northern and North East regions of Ghana.</p><div class="mission-grid"><div><span class="eyebrow">OUR VISION</span><h3>A society without poverty where people live in dignity and harmony.</h3></div><div><span class="eyebrow">OUR MISSION</span><h3>To create a better future for women, children, youth and families in Ghana by empowering them to defeat poverty and achieve social justice.</h3></div></div><h2>Our core values</h2><div class="values-grid"><% [['Integrity','Honest, transparent and accountable service.'],['Excellence','Efficiency and effectiveness in pursuit of impact.'],['Mutual Respect','Recognising dignity, worth and diversity.'],['Truthfulness','Accuracy and honesty in all dealings.'],['Cooperation','Ethical partnerships for the public good.'],['Responsiveness','Sensitivity and flexibility to changing needs.']].forEach(v=>{ %><div class="value-card"><h3><%= v[0] %></h3><p><%= v[1] %></p></div><% }) %></div><h2>Who we serve</h2><p>HOLIDO targets poor and marginalised people, with special attention to those most often left behind: women, farmers, micro-entrepreneurs, children, youth and other marginalised people.</p><h2>Where we work</h2><p>HOLIDO&rsquo;s head office is in Tamale (P.O. Box 2120 Tamale), with programme offices in Bolgatanga and Bunkpurugu. Programmes reach communities in the Upper East, Northern and North East regions of Ghana.</p><h2>Our objectives</h2><ol class="objectives"><li>Strengthen sustainable food security, livelihoods and climate resilience.</li><li>Address the root causes of poverty and vulnerability among women and children.</li><li>Promote access to good quality education in rural areas.</li><li>Promote quality health and wellbeing among women and children.</li><li>Increase access to quality healthcare in rural areas for mothers, children and families.</li><li>Address beliefs that undermine the rights of women and girls.</li><li>Increase women's participation and transformative leadership positions.</li><li>Enhance capacity for emergency preparedness, disaster risk reduction and crisis response.</li></ol><h2>Achievements &amp; milestones</h2><ul><li>Board of Directors formed and active</li><li>3 farmer groups formed</li><li>3 women&rsquo;s groups active on Savings with Education</li><li>10 ECD promoters trained</li><li>5 Early Childhood Development groups formed</li><li>20 schools in the Upper East Region mobilised for ECD rollout</li><li>20 schools trained in learner-centred and gender-sensitive pedagogy</li></ul><p class="muted">Source: HOLIDO&rsquo;s published achievements and milestones.</p></div></section>
<% } else if (pageKey === 'programmes') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">OUR WORK</p><h1>Our programmes</h1><p>Community-led approaches across agriculture, education and health.</p></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">THEMATIC AREAS</p><h2>Our core areas of work</h2></div><p>HOLIDO's published thematic areas and programme descriptions, presented without assigning unrelated photographs to them.</p></div><div class="card-grid three"><% programs.forEach((item,i)=>{ %><article class="program-card"><% if(item.image){ %><img src="<%= item.image %>" <%- imgAttrs(item,' programme') %> loading="lazy" decoding="async"><% } else { %><div class="program-placeholder thematic-icon"><span><%= i===0?'✳':i===1?'▤':'＋' %></span></div><% } %><div class="card-body"><p class="eyebrow">THEMATIC AREA 0<%= i+1 %></p><h3><%= item.title %></h3><%- cardText(item) %><a class="text-link" href="/programmes/<%= item.slug %>">Read more →</a></div></article><% }) %></div></div></section>
<section class="section programmes-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">ON THE GROUND</p><h2>Activities and stories from communities</h2></div><p>These photographs are published on HOLIDO's existing website. Captions identify the activity shown; they are not presented as photographs of every thematic programme.</p></div><div class="card-grid three"><% (gallery||[]).forEach(item=>{ %><article class="program-card"><img src="<%= item.image %>" <%- imgAttrs(item) %> loading="lazy" decoding="async"><div class="card-body"><p class="eyebrow"><%= item.category %></p><h3><%= item.title %></h3><%- fullText(item) %></div></article><% }) %></div><div class="center-action"><a class="btn btn-dark" href="/gallery">View photo gallery →</a></div></div></section>
<% } else if (pageKey === 'projects') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">ON THE GROUND</p><h1>Projects & initiatives</h1><p>Current programme areas reported by HOLIDO. Further project updates can be added as they become available.</p></div></section><section class="section"><div class="container card-grid two"><% projects.forEach(item=>{ %><article class="project-row"><% if(item.image){ %><img src="<%= item.image %>" <%- imgAttrs(item) %> loading="lazy" decoding="async"><% } %><div><p class="eyebrow"><%= item.category %></p><h3><%= item.title %></h3><%- cardText(item) %><a class="text-link" href="/projects/<%= item.slug %>">Project details →</a></div></article><% }) %></div><div class="container note-panel"><strong>Programme information:</strong> This section is ready for HOLIDO to add project locations, dates, partners, objectives, results and photographs through the administration area.</div></section>
<% } else if (pageKey === 'news') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">LATEST UPDATES</p><h1>News & updates</h1><p>Updates and announcements from HOLIDO’s programmes and communities.</p></div></section><section class="section"><div class="container card-grid three"><% news.forEach(item=>{ %><article class="story-card"><% if(item.image){ %><img src="<%= item.image %>" <%- imgAttrs(item) %> loading="lazy" decoding="async"><% } %><div class="card-body"><p class="eyebrow"><%= item.category %><%= fmtDate(item.created_at) ? (item.category?' · ':'')+fmtDate(item.created_at) : '' %></p><h3><%= item.title %></h3><%- cardText(item) %><a class="text-link" href="/news/<%= item.slug %>">Read update →</a></div></article><% }) %><% if(!news.length){ %><p>News and announcements will be published here. HOLIDO administrators can add updates through the content dashboard.</p><% } %></div></section>
<% } else if (pageKey === 'impact') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">REAL LIVES, REAL CHANGE</p><h1>Our impact</h1><p>Stories of resilience, skills, livelihoods and community progress.</p></div></section><section class="section"><div class="container card-grid two"><% stories.forEach(item=>{ %><article class="story-card horizontal"><% if(item.image){ %><img src="<%= item.image %>" <%- imgAttrs(item) %> loading="lazy" decoding="async"><% } %><div class="card-body"><p class="eyebrow"><%= item.location %></p><h3><%= item.title %></h3><%- cardText(item) %><a class="text-link" href="/impact/<%= item.slug %>">Read story →</a></div></article><% }) %></div><div class="container milestones"><p class="eyebrow">ACHIEVEMENTS & MILESTONES REPORTED BY HOLIDO</p><div class="milestone-grid"><div><strong>3</strong><span>Farmers groups formed</span></div><div><strong>3</strong><span>Women’s groups active on Savings with Education</span></div><div><strong>10</strong><span>ECD promoters trained</span></div><div><strong>5</strong><span>Early Childhood Development groups formed</span></div><div><strong>20</strong><span>Schools mobilised for ECD rollout</span></div><div><strong>20</strong><span>Schools trained in learner-centred and gender-sensitive pedagogy</span></div></div><p class="small-muted">These figures are reproduced from the organisation’s source website and should be reviewed by HOLIDO before publication.</p></div></section>
<% } else if (pageKey === 'people') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">OUR PEOPLE</p><h1>People make<br>the mission possible.</h1><p>Meet the Board of Directors who guide HOLIDO’s work with communities across Northern Ghana.</p></div></section>
<section class="section board-section"><div class="container">
<div class="section-heading"><div><p class="eyebrow">GOVERNANCE</p><h2>Board of Directors</h2></div><p>Names, positions and qualifications are taken from HOLIDO’s existing website. Each profile brings together a portrait with a personal profile of the director.</p></div>
<% if(people.length){ %>
<nav class="board-roster" aria-label="Board of Directors: jump to a profile"><% people.forEach(p=>{ %><a class="roster-tile" href="#<%= p.slug %>"><% if(p.image){ %><img class="roster-photo" src="<%= p.image %>" alt="" style="object-position:<%= imgPos(p,'50% 22%') %>" loading="lazy" decoding="async"><% } else { %><span class="roster-initials" aria-hidden="true"><%= initials(p.title) %></span><% } %><span class="roster-name"><%= p.title %></span><span class="roster-role"><%= p.role %></span></a><% }) %></nav>
<div class="profiles">
<% people.forEach((p,i)=>{ const lead=i===0 && /chair/i.test(p.role||''); const traits=tags(p.traits); const expertise=tags(p.expertise); const intro=(p.summary||'').trim(); const quote=(p.quote||'').trim(); const bio=(p.body||'').trim(); %>
<article class="profile<%= lead?' profile--lead':'' %>" id="<%= p.slug %>" aria-labelledby="<%= p.slug %>-name">
<figure class="profile-figure"><% if(p.image){ %><img class="profile-photo" src="<%= p.image %>" alt="<%= p.image_alt || 'Portrait of '+p.title %>" style="object-position:<%= imgPos(p,'50% 22%') %>" loading="lazy" decoding="async"><% } else { %><div class="profile-photo profile-photo--empty" role="img" aria-label="Portrait of <%= p.title %> to be added"><span><%= initials(p.title) %></span></div><% } %></figure>
<div class="profile-main">
<p class="eyebrow"><%= p.role || 'Board member' %></p>
<h3 class="profile-name" id="<%= p.slug %>-name"><%= p.title %></h3>
<% if((p.qualifications||'').trim()){ %><p class="profile-quals"><%= p.qualifications %></p><% } %>
<% if(traits.length){ %><ul class="chips chips--traits" aria-label="Personality in a few words"><% traits.forEach(t=>{ %><li><%= t %></li><% }) %></ul><% } %>
<% if(intro){ %><p class="profile-intro"><%- para(intro) %></p><% } %>
<% if(quote){ %><blockquote class="profile-quote"><%- para(quote) %></blockquote><% } %>
<% if(bio){ %><div class="profile-body rich"><%- rich(bio) %></div><% } %>
<% if(expertise.length){ %><div class="profile-expertise"><h4>Areas of expertise</h4><ul class="chips"><% expertise.forEach(t=>{ %><li><%= t %></li><% }) %></ul></div><% } %>
<% if(!intro && !quote && !bio && !traits.length && !expertise.length){ %><p class="profile-pending">A personal profile will be added here soon.</p><% } %>
</div></article>
<% }) %>
</div>
<% } else { %><div class="note-panel">Board members will appear here once they are published in the administration area.</div><% } %>
</div></section>
<% } else if (pageKey === 'involved') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">GET INVOLVED</p><h1>Be part of<br>lasting change.</h1><p>Work with HOLIDO to support women, children, youth and families across Northern Ghana.</p></div></section><section class="section"><div class="container card-grid three"><article class="involve-card"><span>01</span><h2>Volunteer</h2><p>Bring your skills in agriculture, education, health or community development to support HOLIDO’s programmes.</p><a href="mailto:georgedam@holido.org?subject=Volunteering%20with%20HOLIDO" class="text-link">Express interest →</a></article><article class="involve-card"><span>02</span><h2>Partner with us</h2><p>Government bodies, NGOs, foundations and businesses are welcome to explore collaboration with HOLIDO.</p><a href="mailto:holidoghana@gmail.com?subject=Partnership%20enquiry" class="text-link">Discuss partnership →</a></article><article class="involve-card"><span>03</span><h2>Support our work</h2><p>Contact HOLIDO to discuss appropriate ways to support community programmes and initiatives.</p><a href="mailto:georgedam@holido.org?subject=Supporting%20HOLIDO" class="text-link">Contact HOLIDO →</a></article></div></section>
<% } else if (pageKey === 'contact') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">REACH OUT</p><h1>Let’s start a conversation.</h1><p>For programme enquiries, partnerships, volunteering and general information, contact our team.</p></div></section><section class="section"><div class="container contact-layout"><div class="contact-details"><p class="eyebrow">HOLIDO HEAD OFFICE</p><h2>We’d be glad to hear from you.</h2><div class="contact-line"><b>Address</b><span>NK143 C, Tamale, Ghana</span></div><div class="contact-line"><b>Email</b><a href="mailto:holidoghana@gmail.com">holidoghana@gmail.com</a><a href="mailto:georgedam@holido.org">georgedam@holido.org</a></div><div class="contact-line"><b>Postal address</b><span>P.O. Box 2120, Tamale</span></div><div class="contact-line"><b>Programme offices</b><span>Bolgatanga &amp; Bunkpurugu</span></div><div class="contact-line"><b>Phone / WhatsApp</b><a href="tel:+233249854587">+233 (0) 249 854 587</a><a href="tel:+233203214314">+233 (0) 203 214 314</a></div><div class="contact-line"><b>Contact person</b><span>George Dam Laar (Chairman)</span></div><div class="contact-line"><b>Website</b><a href="https://www.holido.org">www.holido.org</a></div></div><form class="contact-form" method="post" action="/contact"><h2>Send an enquiry</h2><% if(sent){ %><div class="success-message">Thank you. Your message has been received.</div><% } %><% if(error){ %><div class="error-message"><%= error %></div><% } %><input type="hidden" name="_csrf" value="<%= csrf %>"><label>First name<input name="first_name" required maxlength="80" autocomplete="given-name"></label><label>Last name<input name="last_name" required maxlength="80" autocomplete="family-name"></label><label>Email address<input name="email" type="email" required maxlength="180" autocomplete="email"></label><label>Subject<select name="subject" required><option value="">Choose a subject</option><option>General enquiry</option><option>Programme information</option><option>Partnership</option><option>Volunteering</option><option>Media enquiry</option></select></label><label class="full">Message<textarea name="message" rows="5" required minlength="10" maxlength="5000"></textarea></label><label class="hp-field" aria-hidden="true">Leave this field empty<input name="website_check" tabindex="-1" autocomplete="off"></label><button class="btn btn-red" type="submit">Send message →</button><p class="small-muted">Your enquiry is stored securely for the HOLIDO website administrator to review.</p></form></div></section>
<% } else if (pageKey === 'partners') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">WORKING TOGETHER</p><h1>Partners & collaborators</h1><p>HOLIDO values collaboration that supports community-led and sustainable development.</p></div></section><section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">COLLABORATION</p><h2>Working in partnership</h2></div><p>Organisations HOLIDO lists as partners and collaborators. More can be added in the admin area.</p></div><% if(partners.length){ %><div class="card-grid three"><% partners.forEach(item=>{ %><article class="program-card"><% if(item.image){ %><img src="<%= item.image %>" <%- imgAttrs(item) %> loading="lazy" decoding="async"><% } %><div class="card-body"><% if(item.category){ %><p class="eyebrow"><%= item.category %></p><% } %><h3><%= item.title %></h3><%- fullText(item) %></div></article><% }) %></div><% }else{ %><div class="note-panel">Partner profiles will be published here when official names and permissions are supplied.</div><% } %></div></section>
<% } else if (pageKey === 'gallery') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">HOLIDO IN ACTION</p><h1>Photo gallery</h1><p>Photographs from community activities, programmes and events.</p></div></section><section class="section"><div class="container"><% if(gallery.length){ %><div class="card-grid three gallery-masonry"> <% gallery.forEach(item=>{ %><article class="program-card"><% if(item.image){ %><img src="<%= item.image %>" <%- imgAttrs(item) %> loading="lazy" decoding="async"><% } %><div class="card-body"><% if(item.category){ %><p class="eyebrow"><%= item.category %></p><% } %><h3><%= item.title %></h3><%- fullText(item) %></div></article><% }) %></div><% }else{ %><div class="note-panel">Additional photographs will be added by HOLIDO. No placeholder or stock photographs are presented as organisation activities.</div><% } %></div></section>
<% } else if (pageKey === 'resources') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">PUBLICATIONS</p><h1>Resources & publications</h1><p>Reports, publications and learning materials made available by HOLIDO.</p></div></section><section class="section"><div class="container"><% if(documents.length){ %><div class="card-grid two"><% documents.forEach(doc=>{ %><article class="involve-card"><p class="eyebrow"><%= doc.category %></p><h2><%= doc.title %></h2><% if(doc.description){ %><p class="card-text"><%= doc.description %></p><% } %><a class="text-link" href="/documents/<%= doc.id %>/download">Download document ↓</a></article><% }) %></div><% }else{ %><div class="note-panel">Publications will appear here when HOLIDO uploads and approves them.</div><% } %><% if(resources.length){ %><div class="card-grid two" style="margin-top:28px"><% resources.forEach(item=>{ %><article class="involve-card"><h2><%= item.title %></h2><%- fullText(item) %></article><% }) %></div><% } %></div></section>
<% } else if (pageKey === 'donate') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">SUPPORT COMMUNITY-LED DEVELOPMENT</p><h1>Support HOLIDO’s work</h1><p>Contact HOLIDO to discuss appropriate ways to support its programmes and community initiatives.</p></div></section><section class="section"><div class="container content-narrow"><h2>Make an enquiry about giving</h2><p>HOLIDO has not supplied verified online payment instructions for this website. To avoid misleading donors, no payment account or payment gateway is displayed here.</p><p>For verified giving options, please contact <a href="mailto:holidoghana@gmail.com">holidoghana@gmail.com</a> or <a href="mailto:georgedam@holido.org">georgedam@holido.org</a>.</p><a class="btn btn-red" href="/contact">Contact HOLIDO</a></div></section>
<% } else if (pageKey === 'privacy') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">INFORMATION</p><h1>Privacy notice</h1></div></section><section class="section"><div class="container content-narrow"><h2>How we handle enquiries</h2><p>Information submitted through the contact form is used to respond to your enquiry and is available to authorised HOLIDO website administrators. Please do not submit sensitive personal information through this form.</p><p>For questions about personal information submitted to HOLIDO, contact <a href="mailto:georgedam@holido.org">georgedam@holido.org</a>.</p><p>This is an initial website privacy notice and should be reviewed and approved by HOLIDO’s management and legal advisers before the site goes live.</p></div></section>
<% } else if (pageKey === 'detail') { %>
<section class="page-hero detail-hero"><div class="container"><p class="eyebrow light"><%= item.category || 'HOLIDO' %><% if(item.type==='news' && fmtDate(item.created_at)){ %> · <%= fmtDate(item.created_at) %><% } %></p><h1><%= item.title %></h1><% if(item.summary){ %><p class="detail-summary"><%= item.summary %></p><% } %></div></section>
<section class="section detail-section"><div class="container detail-layout<%= item.image ? '' : ' no-image' %>"><article class="detail-main"><a class="text-link" href="<%= back %>">← <%= backLabel %></a><% if(item.body){ %><div class="detail-body rich"><%- rich(item.body) %></div><% } else if(!item.summary){ %><p class="muted">More information will be added soon.</p><% } %><% if(item.author || item.location){ %><p class="detail-byline"><% if(item.author){ %><strong><%= item.author %></strong><% } %><%= item.author && item.location ? ' · ' : '' %><%= item.location %></p><% } %></article><% if(item.image){ %><figure class="detail-figure"><img class="detail-image" src="<%= item.image %>" <%- imgAttrs(item) %> decoding="async"><% if(item.image_alt){ %><figcaption><%= item.image_alt %></figcaption><% } %></figure><% } %></div></section>
<% } %>
<% if(pageKey==='home'){ %><section class="join-cta" id="newsletter"><div class="container"><div><p class="eyebrow light">STAY CONNECTED</p><h2>Follow HOLIDO’s work</h2><p>Receive occasional organisational updates by email.</p><% if(subscribe==='success'){ %><p role="status" style="font-weight:700">Thank you — you are subscribed.</p><% } else if(subscribe){ %><p role="alert" style="font-weight:700">We could not save that email address. Please check it and try again.</p><% } %></div><form method="post" action="/subscribe" class="subscribe-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="hp-field">Leave empty<input name="website_check" tabindex="-1"></label><label class="sr-only" for="subscribe-email">Email address</label><input id="subscribe-email" type="email" name="email" placeholder="Your email address" required maxlength="180"><button class="btn btn-white" type="submit">Subscribe</button></form></div></section><% } %><%- include('partials/footer') %>
