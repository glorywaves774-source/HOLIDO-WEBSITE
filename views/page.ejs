<%
const heroSlides=[
 {img:'hero-community.jpg',pos:'center 43%',portrait:false,label:'Community',alt:'Community members gathered during a HOLIDO community engagement',eyebrow:'COMMUNITY-LED DEVELOPMENT · NORTHERN GHANA',h1:'Building dignity.<br><em>Strengthening</em><br><em>communities.</em>',lead:'Empowering women, children, youth and families across Northern Ghana.',a:['/programmes','Explore our work'],b:['/about','Who we are'],caption:'Working alongside communities for lasting change'},
 {img:'agriculture-community.jpg',pos:'45% 30%',portrait:false,wide:true,label:'Agriculture',alt:'Farmers at Kunjuli No. 1 standing together in front of a painted, thatched compound house',eyebrow:'AGRICULTURE & FOOD SECURITY',h1:'Farming that<br><em>feeds families.</em>',lead:'Working with farmer groups and families to strengthen food security, livelihoods and climate resilience.',a:['/programmes/agriculture-food-security','See our agriculture work'],b:['/projects','Our projects'],caption:'Farmers at Kunjuli No. 1'},
 {img:'marquee/school-outreach.jpg',pos:'50% 14%',portrait:false,label:'Education',alt:'A HOLIDO facilitator shows picture cards to a seated class of pupils under a tree',eyebrow:'EDUCATION',h1:'Learning that<br><em>starts early.</em>',lead:'Early childhood development and learner-centred teaching in rural schools.',a:['/programmes/education','See our education work'],b:['/impact','Read impact stories'],caption:'Outreach session with school pupils'},
 {img:'marquee/women-leaflet.jpg',pos:'50% 40%',portrait:true,label:'Health',alt:'A HOLIDO facilitator going through a leaflet with a group of women in a village',eyebrow:'HEALTH',h1:'Health information<br><em>that reaches home.</em>',lead:'Community outreach that helps women, children and families look after their health.',a:['/programmes/health','See our health work'],b:['/projects','Our projects'],caption:'Sharing health information with women'},
 {img:'marquee/family-visit.jpg',pos:'50% 45%',portrait:true,label:'Families',alt:'A facilitator showing a leaflet to a grandmother and children in a compound',eyebrow:'HOUSEHOLD OUTREACH',h1:'Meeting families<br><em>where they are.</em>',lead:'Household visits bring information and support to the people who need it most.',a:['/impact','Read community stories'],b:['/get-involved','Get involved'],caption:'Household visit with an information leaflet'},
 {img:'marquee/head-office.jpg',pos:'50% 45%',portrait:false,label:'Our team',alt:'Staff gathered outside the HOLIDO head office in Tamale',eyebrow:'TAMALE · BOLGATANGA · BUNKPURUGU',h1:'Based in Tamale,<br><em>serving the north.</em>',lead:'Programme offices in Bolgatanga and Bunkpurugu support communities in the Upper East, Northern and North East regions.',a:['/about','About HOLIDO'],b:['/contact','Contact us'],caption:'The HOLIDO team at the Tamale head office'}
]; %>
<section class="hero" data-hero aria-roledescription="carousel" aria-label="HOLIDO highlights">
<div class="hero-slides" aria-live="off">
<% heroSlides.forEach((s,i)=>{ %>
<div class="hero-slide<%= i===0?' is-active':'' %><%= (s.portrait||s.wide)?' is-framed':'' %><%= s.portrait?' is-portrait':'' %>" role="group" aria-roledescription="slide" aria-label="<%= i+1 %> of <%= heroSlides.length %>: <%= s.label %>">
<div class="hero-bg"><img src="/assets/images/<%= s.img %>" alt="<%= (s.portrait||s.wide) ? '' : s.alt %>" style="object-position:<%= s.pos %>" draggable="false" decoding="async" fetchpriority="<%= i===0?'high':'low' %>"></div>
<div class="hero-shade"></div>
<% if(s.portrait||s.wide){ %><div class="hero-figure"><img src="/assets/images/<%= s.img %>" alt="<%= s.alt %>" draggable="false" decoding="async" fetchpriority="low"></div><% } %>
<div class="container hero-content"><p class="eyebrow light"><%= s.eyebrow %></p><% if(i===0){ %><h1><%- s.h1 %></h1><% } else { %><h2 class="hero-title"><%- s.h1 %></h2><% } %><p class="hero-lead"><%= s.lead %></p><div class="hero-actions"><a class="btn btn-red" href="<%= s.a[0] %>"><%= s.a[1] %> <span>→</span></a><a class="btn btn-outline" href="<%= s.b[0] %>"><%= s.b[1] %> <span>→</span></a></div></div>
<div class="hero-caption"><%= s.caption %></div>
</div>
<% }) %>
</div>
<div class="hero-controls"><div class="container hero-controls-inner">
<button type="button" class="hero-btn hero-prev" aria-label="Previous slide"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
<div class="hero-dots" role="group" aria-label="Choose a slide">
<% heroSlides.forEach((s,i)=>{ %><button type="button" class="hero-dot<%= i===0?' is-active':'' %>" aria-label="Show slide <%= i+1 %>: <%= s.label %>"<%- i===0?' aria-current="true"':'' %>><span class="hero-dot-fill"></span></button><% }) %>
</div>
<button type="button" class="hero-btn hero-next" aria-label="Next slide"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
<button type="button" class="hero-btn hero-toggle" aria-label="Pause slideshow"><svg class="i-pause" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg><svg class="i-play" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg></button>
</div></div>
</section>
<section class="focus-strip"><div class="container focus-grid"><a href="/programmes/agriculture-food-security"><span class="focus-icon">✳</span><span>Agriculture &<br>Food Security</span></a><a href="/programmes/education"><span class="focus-icon">▤</span><span>Education</span></a><a href="/programmes/health"><span class="focus-icon">＋</span><span>Health</span></a></div></section>

<% const fieldPhotos=[['head-office','The HOLIDO team at the Tamale head office','Staff gathered outside the HOLIDO head office in Tamale',1244,700],['family-visit','Household visit with an information leaflet','A facilitator showing a leaflet to a grandmother and children in a compound',525,700],['school-outreach','Outreach session with school pupils','A HOLIDO facilitator shows picture cards to a seated class of pupils under a tree',933,700],['women-leaflet','Sharing health information with women','A HOLIDO facilitator going through a leaflet with a group of women in a village',525,700],['team-meeting','Team planning meeting','HOLIDO staff seated around desks during a team meeting',1244,700]]; %>
<section class="field-marquee" aria-label="Photographs from HOLIDO's work"><div class="container field-marquee-head"><div><h2>In the field</h2><p>Community outreach, household visits and the team behind them.</p></div><button type="button" class="marquee-toggle" aria-label="Pause photo scroll"><svg class="i-pause" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg><svg class="i-play" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg><span class="marquee-toggle-text">Pause</span></button></div><div class="marquee" data-marquee role="group" aria-label="Photographs from HOLIDO's work"><ul class="marquee-set"><% fieldPhotos.forEach(ph=>{ %><li><figure><img src="/assets/images/marquee/<%= ph[0] %>.jpg" width="<%= ph[3] %>" height="<%= ph[4] %>" alt="<%= ph[2] %>" decoding="async" draggable="false"><figcaption><%= ph[1] %></figcaption></figure></li><% }) %></ul></div></section>
<section class="section intro-section"><div class="container intro-grid"><div class="intro-image"><img src="https://www.holido.org/images/WhatsApp%20Image%202026-06-15%20at%2010.01.07%20AM%20%281%29.jpeg" alt="Woman supported through a HOLIDO livelihood initiative" loading="lazy"><span class="image-note">Community-led. People-centred.</span></div><div class="intro-copy"><p class="eyebrow">WHO WE ARE</p><h2>Development that starts with people.</h2><p>Holistic Development Organisation (HOLIDO) is a non-governmental, non-profit organisation working with communities to help people overcome poverty and live with dignity.</p><p>Our work focuses on empowering women, children, youth and other marginalised people across Northern Ghana.</p><a class="text-link" href="/about">Discover HOLIDO <span>→</span></a></div><aside class="vision-card"><span class="vision-mark">◎</span><p class="eyebrow">OUR VISION</p><h3>A society without poverty where people live in dignity and harmony.</h3><a href="/about" class="text-link">Our mission and values →</a></aside></div></section>
<section class="section programmes-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">WHAT WE DO</p><h2>Our thematic areas</h2></div><p>We work with communities to build opportunity, resilience and lasting change.</p></div><div class="card-grid three"> <% programs.forEach((item,i)=>{ %><article class="program-card"><% if(item.image){ %><img src="<%= item.image %>" alt="<%= item.title %> programme" loading="lazy"><% } else { %><div class="program-placeholder"><span><%= i===2?'＋':i===1?'▤':'✳' %></span></div><% } %><div class="card-body"><p class="eyebrow">THEMATIC AREA 0<%= i+1 %></p><h3><%= item.title %></h3><p><%= item.summary %></p><a class="text-link" href="/programmes/<%= item.slug %>">Learn more →</a></div></article><% }) %></div><div class="center-action"><a class="btn btn-dark" href="/programmes">Explore all our work <span>→</span></a></div></div></section>
<section class="impact-band"><div class="container impact-band-inner"><div><p class="eyebrow light">OUR PURPOSE</p><h2>Opportunity, dignity<br>and stronger communities.</h2></div><p>From food security and education to health and livelihoods, our programmes respond to the priorities communities identify for themselves.</p><a class="btn btn-white" href="/impact">Explore our impact →</a></div></section>
<section class="section stories-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">REAL LIVES, REAL CHANGE</p><h2>Stories from our communities</h2></div><a class="text-link" href="/impact">All impact stories →</a></div><div class="card-grid three"><% stories.forEach(item=>{ %><article class="story-card"><% if(item.image){ %><img src="<%= item.image %>" alt="<%= item.title %>" loading="lazy"><% } %><div class="card-body"><p class="eyebrow"><%= item.location || item.category %></p><h3><a class="story-title-link" href="/impact/<%= item.slug %>"><%= item.title %></a></h3><p><%= item.summary %></p><a class="text-link story-read-link" href="/impact/<%= item.slug %>" aria-label="Read the full story: <%= item.title %>">Read full story →</a></div></article><% }) %></div></div></section>
<section class="section partners-section"><div class="container partners-inner"><div><p class="eyebrow">WORKING TOGETHER</p><h2>Partnership makes progress possible.</h2><p>HOLIDO works with public institutions and development partners to support community-led change.</p></div><div class="partner-list"><% if(partners && partners.length){ partners.forEach(partner=>{ %><span><%= partner.title %></span><% }) } else { %><span>Partner information will be added as HOLIDO confirms and approves each profile.</span><% } %><a class="text-link" href="/partners">View partnership information →</a></div></div></section>
<section class="join-cta"><div class="container"><div><p class="eyebrow light">BE PART OF THE CHANGE</p><h2>Let’s build stronger communities together.</h2></div><a class="btn btn-white" href="/get-involved">Get involved <span>→</span></a></div></section>
<% } else if (pageKey === 'about') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">ABOUT HOLIDO</p><h1>People at the heart<br>of development.</h1><p>Working with communities to overcome poverty and live with dignity.</p></div></section><section class="section"><div class="container content-narrow"><p class="eyebrow">WHO WE ARE</p><h2>Holistic Development Organisation (HOLIDO)</h2><p>HOLIDO is a Non-Governmental, Non-Profit Organisation registered with the Registrar General Department (Reg. No. CG086152019) and the Department of Social Welfare (Reg. No. DSW/8097).</p><p>Formed by experienced development practitioners with expertise in Agriculture, Education and Health, we provide quality social services with the vision of helping society overcome poverty and live dignified lives.</p><p>Since inception, HOLIDO has been running development programmes especially for the empowerment of women, children, youth and other marginalised people across the Upper East, Northern and North East regions of Ghana.</p><div class="mission-grid"><div><span class="eyebrow">OUR VISION</span><h3>A society without poverty where people live in dignity and harmony.</h3></div><div><span class="eyebrow">OUR MISSION</span><h3>To create a better future for women, children, youth and families in Ghana by empowering them to defeat poverty and achieve social justice.</h3></div></div><h2>Our core values</h2><div class="values-grid"><% [['Integrity','Honest, transparent and accountable service.'],['Excellence','Efficiency and effectiveness in pursuit of impact.'],['Mutual Respect','Recognising dignity, worth and diversity.'],['Truthfulness','Accuracy and honesty in all dealings.'],['Cooperation','Ethical partnerships for the public good.'],['Responsiveness','Sensitivity and flexibility to changing needs.']].forEach(v=>{ %><div class="value-card"><h3><%= v[0] %></h3><p><%= v[1] %></p></div><% }) %></div><h2>Who we serve</h2><p>HOLIDO targets poor and marginalised people, with special attention to those most often left behind: women, farmers, micro-entrepreneurs, children, youth and other marginalised people.</p><h2>Where we work</h2><p>HOLIDO&rsquo;s head office is in Tamale (P.O. Box 2120 Tamale), with programme offices in Bolgatanga and Bunkpurugu. Programmes reach communities in the Upper East, Northern and North East regions of Ghana.</p><h2>Our objectives</h2><ol class="objectives"><li>Strengthen sustainable food security, livelihoods and climate resilience.</li><li>Address the root causes of poverty and vulnerability among women and children.</li><li>Promote access to good quality education in rural areas.</li><li>Promote quality health and wellbeing among women and children.</li><li>Increase access to quality healthcare in rural areas for mothers, children and families.</li><li>Address beliefs that undermine the rights of women and girls.</li><li>Increase women's participation and transformative leadership positions.</li><li>Enhance capacity for emergency preparedness, disaster risk reduction and crisis response.</li></ol><h2>Achievements &amp; milestones</h2><ul><li>Board of Directors formed and active</li><li>3 farmer groups formed</li><li>3 women&rsquo;s groups active on Savings with Education</li><li>10 ECD promoters trained</li><li>5 Early Childhood Development groups formed</li><li>20 schools in the Upper East Region mobilised for ECD rollout</li><li>20 schools trained in learner-centred and gender-sensitive pedagogy</li></ul><p class="muted">Source: HOLIDO&rsquo;s published achievements and milestones.</p></div></section>
<% } else if (pageKey === 'programmes') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">OUR WORK</p><h1>Our programmes</h1><p>Community-led approaches across agriculture, education and health.</p></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">THEMATIC AREAS</p><h2>Our core areas of work</h2></div><p>HOLIDO's published thematic areas and programme descriptions, presented without assigning unrelated photographs to them.</p></div><div class="card-grid three"><% programs.forEach((item,i)=>{ %><article class="program-card"><div class="program-placeholder thematic-icon"><span><%= i===0?'✳':i===1?'▤':'＋' %></span></div><div class="card-body"><p class="eyebrow">THEMATIC AREA 0<%= i+1 %></p><h3><%= item.title %></h3><p><%= item.summary %></p><a class="text-link" href="/programmes/<%= item.slug %>">Read more →</a></div></article><% }) %></div></div></section>
<section class="section programmes-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">ON THE GROUND</p><h2>Activities and stories from communities</h2></div><p>These photographs are published on HOLIDO's existing website. Captions identify the activity shown; they are not presented as photographs of every thematic programme.</p></div><div class="card-grid three"><% (gallery||[]).forEach(item=>{ %><article class="program-card"><img src="<%= item.image %>" alt="<%= item.title %>" loading="lazy"><div class="card-body"><p class="eyebrow"><%= item.category %></p><h3><%= item.title %></h3><p><%= item.summary %></p></div></article><% }) %></div><div class="center-action"><a class="btn btn-dark" href="/gallery">View photo gallery →</a></div></div></section>
<% } else if (pageKey === 'projects') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">ON THE GROUND</p><h1>Projects & initiatives</h1><p>Current programme areas reported by HOLIDO. Further project updates can be added as they become available.</p></div></section><section class="section"><div class="container card-grid two"><% projects.forEach(item=>{ %><article class="project-row"><% if(item.image){ %><img src="<%= item.image %>" alt="<%= item.title %>" loading="lazy"><% } %><div><p class="eyebrow"><%= item.category %></p><h3><%= item.title %></h3><p><%= item.summary %></p><a class="text-link" href="/projects/<%= item.slug %>">Project details →</a></div></article><% }) %></div><div class="container note-panel"><strong>Programme information:</strong> This section is ready for HOLIDO to add project locations, dates, partners, objectives, results and photographs through the administration area.</div></section>
<% } else if (pageKey === 'news') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">LATEST UPDATES</p><h1>News & updates</h1><p>Updates and announcements from HOLIDO’s programmes and communities.</p></div></section><section class="section"><div class="container card-grid three"><% news.forEach(item=>{ %><article class="story-card"><% if(item.image){ %><img src="<%= item.image %>" alt="<%= item.title %>" loading="lazy"><% } %><div class="card-body"><p class="eyebrow"><%= item.category %></p><h3><%= item.title %></h3><p><%= item.summary %></p><p><%= item.body %></p><a class="text-link" href="/news/<%= item.slug %>">Read update →</a></div></article><% }) %><% if(!news.length){ %><p>News and announcements will be published here. HOLIDO administrators can add updates through the content dashboard.</p><% } %></div></section>
<% } else if (pageKey === 'impact') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">REAL LIVES, REAL CHANGE</p><h1>Our impact</h1><p>Stories of resilience, skills, livelihoods and community progress.</p></div></section><section class="section"><div class="container card-grid two"><% stories.forEach(item=>{ %><article class="story-card horizontal"><% if(item.image){ %><img src="<%= item.image %>" alt="<%= item.title %>" loading="lazy"><% } %><div class="card-body"><p class="eyebrow"><%= item.location %></p><h3><a class="story-title-link" href="/impact/<%= item.slug %>"><%= item.title %></a></h3><p><%= item.summary %></p><a class="text-link story-read-link" href="/impact/<%= item.slug %>" aria-label="Read the full story: <%= item.title %>">Read full story →</a></div></article><% }) %></div><div class="container milestones"><p class="eyebrow">ACHIEVEMENTS & MILESTONES REPORTED BY HOLIDO</p><div class="milestone-grid"><div><strong>3</strong><span>Farmers groups formed</span></div><div><strong>3</strong><span>Women’s groups active on Savings with Education</span></div><div><strong>10</strong><span>ECD promoters trained</span></div><div><strong>5</strong><span>Early Childhood Development groups formed</span></div><div><strong>20</strong><span>Schools mobilised for ECD rollout</span></div><div><strong>20</strong><span>Schools trained in learner-centred and gender-sensitive pedagogy</span></div></div><p class="small-muted">These figures are reproduced from the organisation’s source website and should be reviewed by HOLIDO before publication.</p></div></section>
<% } else if (pageKey === 'people') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">OUR PEOPLE</p><h1>People make<br>the mission possible.</h1><p>Meet the Board of Directors listed on HOLIDO’s current website.</p></div></section><section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">GOVERNANCE</p><h2>Board of Directors</h2></div><p>Leadership details below are taken from the existing HOLIDO website. Portraits and biographies can be added by the organisation.</p></div><div class="people-grid"><% people.forEach(item=>{ %><article class="person-card"><% if(item.image){ %><img class="person-photo" src="<%= item.image %>" alt="Portrait of <%= item.title %>" loading="lazy"><% } else { %><div class="person-initial"><%= item.title.split(' ').filter(Boolean).slice(-2).map(x=>x[0]).join('').toUpperCase() %></div><% } %><div><h3><%= item.title %></h3><p class="person-role"><%= item.role %></p><p><%= item.body %></p></div></article><% }) %></div></div></section>
<% } else if (pageKey === 'involved') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">GET INVOLVED</p><h1>Be part of<br>lasting change.</h1><p>Work with HOLIDO to support women, children, youth and families across Northern Ghana.</p></div></section><section class="section"><div class="container card-grid three"><article class="involve-card"><span>01</span><h2>Volunteer</h2><p>Bring your skills in agriculture, education, health or community development to support HOLIDO’s programmes.</p><a href="mailto:georgedam@holido.org?subject=Volunteering%20with%20HOLIDO" class="text-link">Express interest →</a></article><article class="involve-card"><span>02</span><h2>Partner with us</h2><p>Government bodies, NGOs, foundations and businesses are welcome to explore collaboration with HOLIDO.</p><a href="mailto:holidoghana@gmail.com?subject=Partnership%20enquiry" class="text-link">Discuss partnership →</a></article><article class="involve-card"><span>03</span><h2>Support our work</h2><p>Contact HOLIDO to discuss appropriate ways to support community programmes and initiatives.</p><a href="mailto:georgedam@holido.org?subject=Supporting%20HOLIDO" class="text-link">Contact HOLIDO →</a></article></div></section>
<% } else if (pageKey === 'contact') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">REACH OUT</p><h1>Let’s start a conversation.</h1><p>For programme enquiries, partnerships, volunteering and general information, contact our team.</p></div></section><section class="section"><div class="container contact-layout"><div class="contact-details"><p class="eyebrow">HOLIDO HEAD OFFICE</p><h2>We’d be glad to hear from you.</h2><div class="contact-line"><b>Address</b><span>NK143 C, Tamale, Ghana</span></div><div class="contact-line"><b>Email</b><a href="mailto:holidoghana@gmail.com">holidoghana@gmail.com</a><a href="mailto:georgedam@holido.org">georgedam@holido.org</a></div><div class="contact-line"><b>Postal address</b><span>P.O. Box 2120, Tamale</span></div><div class="contact-line"><b>Programme offices</b><span>Bolgatanga &amp; Bunkpurugu</span></div><div class="contact-line"><b>Phone / WhatsApp</b><a href="tel:+233249854587">+233 (0) 249 854 587</a><a href="tel:+233203214314">+233 (0) 203 214 314</a></div><div class="contact-line"><b>Contact person</b><span>George Dam Laar (Chairman)</span></div><div class="contact-line"><b>Website</b><a href="https://www.holido.org">www.holido.org</a></div></div><form class="contact-form" method="post" action="/contact"><h2>Send an enquiry</h2><% if(sent){ %><div class="success-message">Thank you. Your message has been received.</div><% } %><% if(error){ %><div class="error-message"><%= error %></div><% } %><input type="hidden" name="_csrf" value="<%= csrf %>"><label>First name<input name="first_name" required maxlength="80" autocomplete="given-name"></label><label>Last name<input name="last_name" required maxlength="80" autocomplete="family-name"></label><label>Email address<input name="email" type="email" required maxlength="180" autocomplete="email"></label><label>Subject<select name="subject" required><option value="">Choose a subject</option><option>General enquiry</option><option>Programme information</option><option>Partnership</option><option>Volunteering</option><option>Media enquiry</option></select></label><label class="full">Message<textarea name="message" rows="5" required minlength="10" maxlength="5000"></textarea></label><label class="hp-field" aria-hidden="true">Leave this field empty<input name="website_check" tabindex="-1" autocomplete="off"></label><button class="btn btn-red" type="submit">Send message →</button><p class="small-muted">Your enquiry is stored securely for the HOLIDO website administrator to review.</p></form></div></section>
<% } else if (pageKey === 'partners') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">WORKING TOGETHER</p><h1>Partners & collaborators</h1><p>HOLIDO values collaboration that supports community-led and sustainable development.</p></div></section><section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">COLLABORATION</p><h2>Working in partnership</h2></div><p>Organisations HOLIDO lists as partners and collaborators. More can be added in the admin area.</p></div><% if(partners.length){ %><div class="card-grid three"><% partners.forEach(item=>{ %><article class="program-card"><% if(item.image){ %><img src="<%= item.image %>" alt="<%= item.title %>" loading="lazy"><% } %><div class="card-body"><h3><%= item.title %></h3><p><%= item.summary %></p></div></article><% }) %></div><% }else{ %><div class="note-panel">Partner profiles will be published here when official names and permissions are supplied.</div><% } %></div></section>
<% } else if (pageKey === 'gallery') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">HOLIDO IN ACTION</p><h1>Photo gallery</h1><p>Photographs from community activities, programmes and events.</p></div></section><section class="section"><div class="container"><% if(gallery.length){ %><div class="card-grid three"> <% gallery.forEach(item=>{ %><article class="program-card"><% if(item.image){ %><img src="<%= item.image %>" alt="<%= item.title %>" loading="lazy"><% } %><div class="card-body"><h3><%= item.title %></h3><p><%= item.summary %></p></div></article><% }) %></div><% }else{ %><div class="note-panel">Additional photographs will be added by HOLIDO. No placeholder or stock photographs are presented as organisation activities.</div><% } %></div></section>
<% } else if (pageKey === 'resources') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">PUBLICATIONS</p><h1>Resources & publications</h1><p>Reports, publications and learning materials made available by HOLIDO.</p></div></section><section class="section"><div class="container"><% if(documents.length){ %><div class="card-grid two"><% documents.forEach(doc=>{ %><article class="involve-card"><p class="eyebrow"><%= doc.category %></p><h2><%= doc.title %></h2><p><%= doc.description %></p><a class="text-link" href="/documents/<%= doc.id %>/download">Download document ↓</a></article><% }) %></div><% }else{ %><div class="note-panel">Publications will appear here when HOLIDO uploads and approves them.</div><% } %><% if(resources.length){ %><div class="card-grid two" style="margin-top:28px"><% resources.forEach(item=>{ %><article class="involve-card"><h2><%= item.title %></h2><p><%= item.summary %></p><% if(item.body){ %><p><%= item.body %></p><% } %></article><% }) %></div><% } %></div></section>
<% } else if (pageKey === 'donate') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">SUPPORT COMMUNITY-LED DEVELOPMENT</p><h1>Support HOLIDO’s work</h1><p>Contact HOLIDO to discuss appropriate ways to support its programmes and community initiatives.</p></div></section><section class="section"><div class="container content-narrow"><h2>Make an enquiry about giving</h2><p>HOLIDO has not supplied verified online payment instructions for this website. To avoid misleading donors, no payment account or payment gateway is displayed here.</p><p>For verified giving options, please contact <a href="mailto:holidoghana@gmail.com">holidoghana@gmail.com</a> or <a href="mailto:georgedam@holido.org">georgedam@holido.org</a>.</p><a class="btn btn-red" href="/contact">Contact HOLIDO</a></div></section>
<% } else if (pageKey === 'privacy') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light">INFORMATION</p><h1>Privacy notice</h1></div></section><section class="section"><div class="container content-narrow"><h2>How we handle enquiries</h2><p>Information submitted through the contact form is used to respond to your enquiry and is available to authorised HOLIDO website administrators. Please do not submit sensitive personal information through this form.</p><p>For questions about personal information submitted to HOLIDO, contact <a href="mailto:georgedam@holido.org">georgedam@holido.org</a>.</p><p>This is an initial website privacy notice and should be reviewed and approved by HOLIDO’s management and legal advisers before the site goes live.</p></div></section>
<% } else if (pageKey === 'detail') { %>
<section class="page-hero"><div class="container"><p class="eyebrow light"><%= item.category || 'HOLIDO' %></p><h1><%= item.title %></h1><p><%= item.summary %></p></div></section><section class="section"><div class="container detail-layout"><div><a class="text-link" href="<%= back %>">← <%= backLabel %></a><p class="eyebrow detail-kicker">FULL STORY</p><h2><%= item.title %></h2><div class="detail-body"><%= item.body %></div><% if(item.author){ %><p class="eyebrow"><%= item.author %><%= item.location ? ' · '+item.location : '' %></p><% } %></div><% if(item.image){ %><img class="detail-image" src="<%= item.image %>" alt="<%= item.title %>"><% } %></div></section>
<% } %>
<% if(pageKey==='home'){ %><section class="join-cta" id="newsletter"><div class="container"><div><p class="eyebrow light">STAY CONNECTED</p><h2>Follow HOLIDO’s work</h2><p>Receive occasional organisational updates by email.</p><% if(subscribe==='success'){ %><p role="status" style="font-weight:700">Thank you — you are subscribed.</p><% } else if(subscribe){ %><p role="alert" style="font-weight:700">We could not save that email address. Please check it and try again.</p><% } %></div><form method="post" action="/subscribe" class="subscribe-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="hp-field">Leave empty<input name="website_check" tabindex="-1"></label><label class="sr-only" for="subscribe-email">Email address</label><input id="subscribe-email" type="email" name="email" placeholder="Your email address" required maxlength="180"><button class="btn btn-white" type="submit">Subscribe</button></form></div></section><% } %><%- include('partials/footer') %>
